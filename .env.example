# ---------------------------------------------------------------------------
# Fitness with Libby — environment variables
# ---------------------------------------------------------------------------
# Copy this file to ".env.local" for local dev, and set the SAME two values in
# your hosting provider's "Environment Variables" settings for the live site.
# ".env.local" is gitignored on purpose — the real token must never be committed.
#
# 🔑 SWITCHING TO A NEW AIRTABLE ACCOUNT (e.g. handing the base off to Libby):
#   1. In the new account, create a Personal Access Token at
#        https://airtable.com/create/tokens
#      with scopes: data.records:read, data.records:write, schema.bases:read
#      and access to the "Fitness with Libby" base.
#   2. Copy the base id (starts with "app…"). It stays the same if the base is
#      TRANSFERRED to the new account; it changes if the base is DUPLICATED.
#   3. Paste both values below (in .env.local) AND into the host's env settings,
#      then redeploy the site.
# ---------------------------------------------------------------------------

AIRTABLE_TOKEN=your_personal_access_token_here
AIRTABLE_BASE_ID=your_base_id_here

# Password for the studio admin page (app/admin). Libby types this to log in.
# Set the same value in Vercel's Environment Variables. Pick something memorable.
ADMIN_PASSWORD=choose_a_password
